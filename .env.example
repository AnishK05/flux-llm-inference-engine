FLUX_MODEL=Qwen/Qwen2.5-0.5B-Instruct
FLUX_DTYPE=fp32
FLUX_DEVICE=cpu
FLUX_MAX_BATCH_SIZE=8
FLUX_MAX_WAITING=256
FLUX_BLOCK_SIZE=16
FLUX_NUM_KV_BLOCKS=auto
FLUX_MAX_SEQ_LEN=1024
FLUX_SCHEDULER=fcfs
FLUX_INTRA_THREADS=auto
FLUX_REDIS_URL=redis://localhost:6379/0
FLUX_ENABLE_REDIS=false
FLUX_RATE_LIMIT_PER_MIN=120
FLUX_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FLUX_LOAD_MODEL=true
FLUX_MAX_NEW_TOKENS_CAP=64
FLUX_SERVE_ENGINE=continuous
HF_HOME=.hf-cache
